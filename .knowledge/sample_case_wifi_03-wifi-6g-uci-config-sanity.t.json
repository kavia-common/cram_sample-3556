{"is_source_file": true, "format": "shell script", "description": "This file is a shell script containing comments, guidelines, and commands related to checking and validating 6GHz Wi-Fi configuration settings on OpenWrt routers. It includes references, notes on handling 6GHz configurations, and sample commands for querying wireless settings using uci.", "external_files": ["wireless"], "external_methods": ["uci show"], "published": [], "classes": [], "methods": [], "calls": ["command -v uci", "uci -q show wireless", "sed 's/@[0-9]\\+/@N/g'", "grep -Ei 'wireless\\.radio[0-9]+\\.(band|hwmode|country|channel|disabled|htmode)'", "grep -Ei 'wireless\\.@wifi-device\\[N\\]\\.(band|hwmode|country|channel|disabled|htmode)'", "uci show wireless"], "search-terms": ["6GHz WiFi OpenWrt", "UCI wireless config sanity", "wireless radio 6g", "WiFi 6E configuration", "OpenWrt 6GHz verification"], "state": 2, "file_id": 39, "knowledge_revision": 100, "git_revision": "755f68726dfece31cffbc243434300824ea838c0", "hash": "727536b1116efa1319ffb07fec63980b", "format-version": 4, "code-base-name": "cram_sample-3556", "filename": "sample_case/wifi/03-wifi-6g-uci-config-sanity.t", "revision_history": [{"100": "755f68726dfece31cffbc243434300824ea838c0"}]}