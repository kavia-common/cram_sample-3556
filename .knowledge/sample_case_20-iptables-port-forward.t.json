{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script which configures DNAT port forwarding rules in an OpenWrt environment using UCI commands, and verifies their application with iptables rules. It includes setting environment variables, creating firewall rules, verifying NAT PREROUTING entries, and cleaning up rules.", "external_files": ["/etc/init.d/firewall", "iptables"], "external_methods": ["uci", "awk", "grep", "sed", "sort", "uniq"], "published": [], "classes": [], "methods": [], "calls": ["uci -q add firewall redirect", "uci -q show firewall", "awk -F= '/^firewall.@redirect\\[[0-9]+\\]=redirect/'", "uci -q set firewall.@redirect[${INDEX}].name=${RULE_NAME}", "uci -q set firewall.@redirect[${INDEX}].src='wan'", "uci -q set firewall.@redirect[${INDEX}].src_dport=${WAN_PORT}", "uci -q set firewall.@redirect[${INDEX}].dest='lan'", "uci -q set firewall.@redirect[${INDEX}].dest_ip=${LAN_HOST}", "uci -q set firewall.@redirect[${INDEX}].dest_port=${LAN_PORT}", "uci -q set firewall.@redirect[${INDEX}].proto='tcp'", "uci -q commit firewall", "/etc/init.d/firewall reload", "iptables -t nat -S PREROUTING", "grep -E -- '-p tcp .* --dport' ${WAN_PORT}", "sed 's/[[:space:]]\\+/ /g'", "sort", "uniq", "uci -q changes firewall", "uci -q revert firewall", "uci -q show firewall", "uci -q get firewall.@redirect[$i].name", "uci -q delete firewall.@redirect[$i]", "uci -q commit firewall", "/etc/init.d/firewall reload", "echo \"Cleaned DNAT rule ${RULE_NAME}\""], "search-terms": ["DNAT", "firewall redirect", "iptables PREROUTING", "UCI firewall", "port forwarding", "openwrt", "nAT rule"], "state": 2, "file_id": 14, "knowledge_revision": 60, "git_revision": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300", "hash": "81b29b0dfde31710b598b41d2664646c", "format-version": 4, "code-base-name": "cram_sample-3556", "filename": "sample_case/20-iptables-port-forward.t", "revision_history": [{"60": "81291f4c5b3c6bd2b7dccfcc61d9a81249a15300"}]}