{"is_source_file": true, "format": "shell script", "description": "This file contains a shell script for managing NAT (Network Address Translation) configurations on a firewall using UCI commands and iptables. It includes functions to determine WAN zone index, temporarily enable masquerading, verify masquerade rules, add per-LAN SNAT rules, and restore previous settings, primarily for testing or configuration purposes.", "external_files": ["firewall", "/etc/init.d/firewall"], "external_methods": ["uci", "iptables-save", "iptables"], "published": ["get_zone_idx"], "classes": [], "methods": [{"name": "get_zone_idx", "description": "Function to get the index of a specified zone (e.g., 'wan') in the firewall's zone list using UCI and AWK."}], "calls": ["uci -q show firewall", "awk -F\"[=\\[\\]]\" -v Z=\"$1\" \"$0 ~ /^firewall.@zone\\[/ {idx=$3} ...\"", "sed \"s/[0-9]\\+/\\<IDX>\\\"", "uci -q get firewall.@zone[$WAN_IDX].masq", "/etc/init.d/firewall reload", "iptables-save -t nat", "grep -E \"^-A POSTROUTING\"", "grep -E \"\\bMASQUERADE\\b\"", "sed \"s/[[:space:]]\\+/ /g\"", "ip -o link show", "iptables -t nat -I POSTROUTING 1 -o \"$LAN_IF\" -j SNAT --to-source 192.0.2.5", "iptables-save -t nat", "iptables -t nat -D POSTROUTING -o \"$LAN_IF\" -j SNAT --to-source 192.0.2.5", "uci -q set firewall.@zone[$WAN_IDX].masq=\"$WAN_MASQ_BEFORE\"", "uci -q del firewall.@zone[$WAN_IDX].masq", "/etc/init.d/firewall reload"], "search-terms": ["NAT", "MASQUERADE", "SNAT", "firewall", "iptables", "uci", "get_zone_idx", "wan", "zone", "masq", "SNAT configuration"], "state": 2, "file_id": 15, "knowledge_revision": 78, "git_revision": "701c8e32dbee0325864768a278d7aacaebfb9f05", "hash": "53c19be5812bfef8ed40aafbe9a7bf8a", "format-version": 4, "code-base-name": "cram_sample-3556", "filename": "sample_case/iptables/37-iptables-nat-masquerade.t", "revision_history": [{"78": "701c8e32dbee0325864768a278d7aacaebfb9f05"}]}