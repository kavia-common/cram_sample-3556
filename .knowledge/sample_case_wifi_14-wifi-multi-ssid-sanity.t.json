{"is_source_file": true, "format": "Tcl script", "description": "This file is a test script for checking the configuration of multiple Wi-Fi SSIDs and interfaces using UCI commands. It performs various sanity checks such as verifying UCI presence, wireless configuration availability, counting wifi-iface sections, listing SSIDs, and enumerating encryption modes.", "external_files": ["sample_case/02-sample2.t"], "external_methods": ["uci", "grep", "sed", "wc", "tr", "sort", "head"], "published": [], "classes": [], "methods": [], "calls": ["command -v uci", "uci -q show wireless", "uci show wireless", "grep -E \"wireless\\.@wifi-iface\\[[0-9]+\\]=wifi-iface\"", "wc -l", "tr -d \" \"", "sed \"s/@[0-9]\\+/@N/g\"", "grep -E \"wireless\\.@wifi-iface\\[N\\]\\.ssid=\"", "sort", "sed \"s/@[0-9]\\+/@N/g\"", "grep -E \"wireless\\.@wifi-iface\\[N\\]\\.(encryption|ieee80211w|sae|owe)=\"", "head -n 50"], "search-terms": ["wifi", "UCI", "SSID", "wireless configuration", "multi-SSID sanity check"], "state": 2, "file_id": 50, "knowledge_revision": 123, "git_revision": "cfb08bb13c55095959f3c85f4df91019421335d9", "hash": "081abbbe077daeee2899ae4a5b47833e", "format-version": 4, "code-base-name": "cram_sample-3556", "filename": "sample_case/wifi/14-wifi-multi-ssid-sanity.t", "revision_history": [{"123": "cfb08bb13c55095959f3c85f4df91019421335d9"}]}